# ============================================================================
# cjhirashi-career Environment Variables
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in with real values
# NEVER commit .env to the repository
# ============================================================================

# ============================================================================
# PostgreSQL Database
# ============================================================================
POSTGRES_USER=career_admin
POSTGRES_PASSWORD=your-secure-password-here-min-20-chars
POSTGRES_DB=career_db
DATABASE_URL=postgresql+asyncpg://career_admin:your-secure-password-here-min-20-chars@postgres:5432/career_db

# ============================================================================
# API REST - Security
# ============================================================================
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# API REST - CORS (comma-separated, no spaces)
# ============================================================================
CORS_ORIGINS=http://localhost:8002,http://localhost:8003

# ============================================================================
# API REST - Application
# ============================================================================
APP_NAME=cjhirashi-career
APP_VERSION=3.0.0
DEBUG=false
UPLOADS_DIR=/app/uploads

# ============================================================================
# AWS Bedrock — Converse API. Ver docs/BEDROCK-SYSTEM.md
# ============================================================================
BEDROCK_REGION=us-east-1
BEDROCK_DEFAULT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_ORCHESTRATOR_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_IMAGE_REGION=us-west-2
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-core-v1:1
BEDROCK_MAX_IMAGES_PER_DAY=20
BEDROCK_DAILY_BUDGET_USD=5.0
BEDROCK_MAX_ROUND_TRIPS=6
BEDROCK_HISTORY_WINDOW=20
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# Qdrant (base de conocimiento local de Agent Bedrock)
# ============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=career_knowledge

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_UPLOAD_SIZE_MB=50

# ============================================================================
# MinIO (bucket de archivos - almacenamiento de objetos S3-compatible)
# ============================================================================
# Endpoint interno (host:puerto del contenedor minio, red Docker) - la app
# nunca sale a internet para subir/listar/borrar, solo para servir el link
# público de descarga.
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=portafolio-minio-admin
MINIO_ROOT_PASSWORD=your-secure-password-here-min-20-chars
MINIO_BUCKET=cjhirashi-career
# URL pública del bucket - expuesta vía Caddy en cjhirashi-srv, ver
# servicios-externos/cjhirashi-career.md para la configuración exacta.
MINIO_PUBLIC_URL=https://files.cjhirashi.com

# ============================================================================
# LinkedIn OAuth (Share on LinkedIn + Sign In with LinkedIn using OpenID
# Connect - both self-serve products from https://www.linkedin.com/developers/apps,
# no LinkedIn app review needed). Redirect URI must be added to the app's
# "Authorized redirect URLs" exactly as below.
# ============================================================================
LINKEDIN_CLIENT_ID=your-linkedin-app-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-app-client-secret
LINKEDIN_REDIRECT_URI=https://admin.cjhirashi.com/api/linkedin/callback
LINKEDIN_FRONTEND_URL=https://admin.cjhirashi.com/linkedin

# ============================================================================
# Job discovery (Indeed via Adzuna — free developer keys at adzuna.com)
# ============================================================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=mx
JOB_DISCOVERY_TIMEOUT_SECONDS=8
JOB_DISCOVERY_MAX_RESULTS=50

# ============================================================================
# GitHub (L3 agent_github — solo lectura)
# Fine-grained PAT o classic: Contents Read + Metadata. Private: también
# Repository access a tus repos. Sin token, solo repos públicos del username
# guardado en github-profile.
# ============================================================================
GITHUB_TOKEN=

# ============================================================================
# Consulta web (L3 agent_web_search)
# Opcional. Si vacío, web_search usa DuckDuckGo HTML.
# ============================================================================
BRAVE_SEARCH_API_KEY=

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# Public Portal - prefixed user id (users.id, e.g. usr-2). Not a raw integer.
# Unauthenticated /public/* routes are scoped to this owner only.
PUBLIC_PORTAL_USER_ID=usr-2
